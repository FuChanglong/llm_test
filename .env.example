# VLLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLLM_API_KEY=your-api-key
# VLLM_MODEL=qwen-turbo
VLLM_MAX_TOKENS=900
VLLM_TIMEOUT_SECONDS=120
VLLM_TRUST_ENV=0

# DeepSeek OpenAI-compatible example:
# VLLM_BASE_URL=https://api.deepseek.com
# VLLM_API_KEY=your-deepseek-api-key
# VLLM_MODEL=deepseek-chat

# Dedicated DeepSeek key for offline RAG eval dataset generation.
# DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90

# Image generation/editing via OpenAI-compatible API:
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=your-image-api-key
IMAGE_MODEL=qwen-image-2.0-pro
IMAGE_EDIT_MODEL=qwen-image-2.0-pro
IMAGE_TIMEOUT_SECONDS=120

# Multimodal image analysis. Keep separate from VLLM_* so DeepSeek remains the default chat model.
OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OMNI_API_KEY=your-omni-api-key
OMNI_MODEL=qwen3.5-omni-plus-2026-03-15
OMNI_MAX_TOKENS=900
OMNI_TIMEOUT_SECONDS=120
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

EMBEDDER_TYPE=hash
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDER_DIMENSIONS=384
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=160
RAG_CHILD_CHUNK_SIZE=420
RAG_PARENT_CHUNK_SIZE=1400
RAG_DENSE_CANDIDATES=16
RAG_SPARSE_CANDIDATES=16
RAG_TOP_K=6
RAG_MIN_SCORE=0.15
RAG_USE_QUERY_REWRITE=0
RERANKER_TYPE=none
RERANKER_MODEL=BAAI/bge-reranker-base

MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8765
LANGCHAIN_DOCS_MCP_URL=https://docs.langchain.com/mcp

API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_MEMORY_DIR=chat_memory
CHAT_DB_PATH=chat_memory/chat.sqlite3
MEMORY_COMPRESS_TRIGGER=30
MEMORY_KEEP_RECENT=12
MEMORY_MAX_TOKEN_LIMIT=2000
